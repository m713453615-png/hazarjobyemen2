# Shared build defaults for every edition of Hazar-Job.com.
#
# Mode specific files (.env.public, .env.owner) override these values.
# Never put secrets in a VITE_* variable: everything prefixed with VITE_ is
# compiled into the client bundle and stays readable by every visitor.

# Manual payment confirmation (receipt + transfer reference) before a job is published.
VITE_MANUAL_PAYMENTS=false
